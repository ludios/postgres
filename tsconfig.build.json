// Model-output: Claude Opus 5.5
{
	// Emits the JavaScript in dist/ that the published package runs:
	// Node refuses to strip types from .ts files inside node_modules.
	"extends": "./tsconfig.json",
	"compilerOptions": {
		"noEmit": false,
		// `pnpm typecheck` checks the types; the build only emits.
		"noCheck": true,
		"rewriteRelativeImportExtensions": true,
		"rootDir": "src",
		"outDir": "dist"
	},
	"include": ["src"]
}
