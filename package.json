{
  "name": "postgres",
  "version": "4.0.0",
  "description": "Fastest full featured PostgreSQL client for Node.js, Bun and Cloudflare Workers",
  "type": "module",
  "main": "dist/index.js",
  "types": "types/index.d.ts",
  "exports": {
    ".": {
      "types": "./types/index.d.ts",
      "workerd": "./dist/cf.js",
      "default": "./dist/index.js"
    }
  },
  "engines": {
    "node": ">=22"
  },
  "devEngines": {
    "runtime": {
      "name": "node",
      "version": ">=22.18",
      "onFail": "error"
    }
  },
  "scripts": {
    "test": "node tests/unit/index.ts && node tests/index.ts && node tests/simulate.ts",
    "test:unit": "node tests/unit/index.ts",
    "test:integration": "node tests/index.ts",
    "test:simulate": "node tests/simulate.ts",
    "coverage": "node tests/coverage.ts",
    "prepare": "rm -rf dist && node node_modules/typescript/bin/tsc -p tsconfig.build.json",
    "typecheck": "node node_modules/typescript/bin/tsc && node node_modules/typescript/bin/tsc -p types && node node_modules/typescript5/bin/tsc -p types",
    "lint": "eslint src tests"
  },
  "files": [
    "/dist/*.js",
    "/types/index.d.ts"
  ],
  "author": "Rasmus Porsager <rasmus@porsager.com> (https://www.porsager.com)",
  "funding": {
    "type": "individual",
    "url": "https://github.com/sponsors/porsager"
  },
  "license": "Unlicense",
  "repository": "porsager/postgres",
  "packageManager": "pnpm@11.28.7",
  "devDependencies": {
    "@types/node": "^22.20.5",
    "typescript": "7.0.2",
    "typescript5": "npm:typescript@^5.9.3"
  }
}
