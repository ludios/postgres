{
	"$schema": "./node_modules/oxlint/configuration_schema.json",

	"options": {
		"typeAware": true,
		"typeCheck": true
	},

	"plugins": [
		"eslint",
		"typescript",
		"unicorn",
		"oxc",
		"import",
		"promise",
		"vitest"
	],

	"categories": {
		"correctness": "error",
		"suspicious": "warn",
		"perf": "warn"
	},

	"ignorePatterns": [
		"**/dist/**",
		// Upstream's hand-written public types, and the type-level tests that
		// tsc checks but nothing runs.
		"types/**"
	],

	"overrides": [
		{
			"files": ["tests/**"],
			"rules": {
				// A test's helper may sit inside the test that uses it, even when it
				// closes over nothing.
				"unicorn/consistent-function-scoping": "off",
				// simulate.ts, soak.ts and failover.ts print their reports with it, and
				// some tests replace console.log on purpose.
				"no-console": "off"
			}
		},
		{
			// The existing code breaks these rules, so they are warnings until the
			// code is cleaned up. Delete a rule from this list once no code breaks
			// it, so that it is an error again.
			"files": ["**/*.ts"],
			"rules": {
				"typescript/unbound-method": "warn",
				"typescript/await-thenable": "warn",
				"typescript/no-base-to-string": "warn",
				"unicorn/no-unnecessary-await": "warn",
				"typescript/require-array-sort-compare": "warn",
				"unicorn/prefer-string-starts-ends-with": "warn",
				"typescript/no-misused-spread": "warn"
			}
		}
	],

	"rules": {
		"typescript/no-floating-promises": "error",
		"import/no-cycle": ["error", { "maxDepth": 8 }],
		"no-console": ["error", { "allow": ["warn", "error"] }],
		"no-debugger": "error",
		// AGENTS.md: "Use the { } curlies even for one-statement blocks."
		"curly": ["error", "all"],
		// https://typescript-eslint.io/rules/consistent-return/
		// A function returns a value on every path, or on none: `return f();` in
		// a function that returns nothing hides that f()'s value is dropped.
		"typescript/consistent-return": "error",
		// https://oxc.rs/docs/guide/usage/linter/rules/eslint/no-shadow.html
		// Except `sql`, the name of a function that makes queries where no more
		// specific name (`tx`, `sp`, `reserved`) fits, which often hides an outer
		// `sql`: a test's own pool, a helper's parameter that takes a pool or a
		// transaction, and what Sql() returns in src/index.ts.
		"no-shadow": ["error", { "allow": ["sql"] }],
		// https://oxc.rs/docs/guide/usage/linter/rules/unicorn/consistent-function-scoping.html
		// A function that closes over nothing goes at module level, where it is
		// plainly independent of the state of the function it was nested in.
		"unicorn/consistent-function-scoping": "error",
		// Also the sequences in parentheses, which is how oxfmt writes most of them.
		"no-sequences": ["error", { "allowInParentheses": false }],
		// https://oxc.rs/docs/guide/usage/linter/rules/eslint/no-underscore-dangle.html
		// This is just annoying.
		"no-underscore-dangle": "off",
		// https://oxc.rs/docs/guide/usage/linter/rules/eslint/no-unused-vars.html
		// Should be a warning, not an error. A name with a leading underscore is
		// unused on purpose: the arguments that a noop takes, or `await using _x`.
		"no-unused-vars": ["warn", { "argsIgnorePattern": "^_", "varsIgnorePattern": "^_" }],
		// https://oxc.rs/docs/guide/usage/linter/rules/unicorn/no-new-array.html
		// `new Array(n)` preallocates an array of n values on purpose, in the code
		// that reads every row.
		"unicorn/no-new-array": "off",
		// https://oxc.rs/docs/guide/usage/linter/rules/unicorn/prefer-add-event-listener.html
		// Our socket objects are not EventTargets: `onclose` and the like are plain
		// properties that hold one function.
		"unicorn/prefer-add-event-listener": "off",
		// https://oxc.rs/docs/guide/usage/linter/rules/oxc/no-map-spread.html
		// Copying each object in map() is how we avoid changing the caller's objects.
		"oxc/no-map-spread": "off",
		// https://oxc.rs/docs/guide/usage/linter/rules/unicorn/no-useless-spread.html
		// A bad rule: it will stop you from doing [...something] to copy e.g. a Set
		// to avoid issues with it being mutated as you iterate it.
		"unicorn/no-useless-spread": "off",
		// https://oxc.rs/docs/guide/usage/linter/rules/promise/always-return.html
		// seems to be a silly rule for novice users of Promise who e.g. unnecessarily
		// use more than one `then(...)`.
		"promise/always-return": "off",
		// https://oxc.rs/docs/guide/usage/linter/rules/promise/no-callback-in-promise.html
		// https://oxc.rs/docs/guide/usage/linter/rules/promise/no-promise-in-callback.html
		// Both go by the name alone: a call of a `done` or `callback` inside then(), or a
		// promise inside a function that has a `callback` parameter. This code settles its
		// local `done` functions from promises, and Node's stream callbacks from queries.
		"promise/no-callback-in-promise": "off",
		"promise/no-promise-in-callback": "off",
		// https://oxc.rs/docs/guide/usage/linter/rules/eslint/no-await-in-loop
		// Silly rule for novices who don't know what they're doing.
		"no-await-in-loop": "off",
		// https://oxc.rs/docs/guide/usage/linter/rules/vitest/valid-expect.html
		// Allow vitest's second argument to `expect`, a message that a failure shows.
		"vitest/valid-expect": ["error", { "maxArgs": 2 }],
		// https://typescript-eslint.io/rules/no-unsafe-type-assertion/
		// We cast deliberately at I/O boundaries.
		"typescript/no-unsafe-type-assertion": "off",
		// These need `strictNullChecks`, which `strict: false` in tsconfig.json
		// turns off; without it, each only reports, once per file, that it needs it.
		"typescript/no-useless-default-assignment": "off",
		"typescript/no-unnecessary-boolean-literal-compare": "off"
	}
}
