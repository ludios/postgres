#!/usr/bin/env bash
# Replaces the message of a commit on the current branch, even while other processes commit in
# the same working tree.
#
# Usage: scripts/git-reword COMMIT < NEW_MESSAGE
#
# `git history reword` (an experimental command, in Git 2.56) makes the new commits: COMMIT with
# the new message, and the commits after it with new parents. It touches neither the working tree
# nor the index, and here it runs in a private git directory that shares the repository's objects
# and refs, so that it does not use the COMMIT_EDITMSG that a concurrent `git commit` uses. Then
# `git update-ref --stdin` moves the branch to the new commits, but only if the branch still points
# where it pointed when the rewording began; otherwise, the rewording begins again, so a commit
# made meanwhile is never lost. A `git commit` that runs at the very moment the branch moves fails
# without changing anything, and then needs running again.
#
# It refuses to reword a commit that another branch, a remote-tracking branch or a tag contains
# (because they would keep the old commits), and a commit that is signed or has a signed commit
# after it (because `git history` would drop the signature). `git history` itself refuses a
# commit that has a merge commit after it, and an empty message.
set -euo pipefail

max_attempts=10
# `git history` drops the lines of the new message that start with this
comment=git-reword-comment:

fail() {
	echo "git-reword: $1" >&2
	exit 1
}

if [[ $# -ne 1 || -t 0 ]]; then
	echo "Usage: scripts/git-reword COMMIT < NEW_MESSAGE" >&2
	exit 2
fi

target=$(git rev-parse -q --verify --end-of-options "$1^{commit}") || fail "$1 is not a commit"
branch=$(git symbolic-ref -q HEAD) || fail "HEAD is not on a branch"

private=$(mktemp -d)
trap 'rm -rf "$private"' EXIT
echo "ref: $branch" > "$private/HEAD"
git rev-parse --path-format=absolute --git-common-dir > "$private/commondir"
cat > "$private/message"
if grep -q "^$comment" "$private/message"; then
	fail "a line of the new message starts with $comment"
fi

for ((attempt = 1; attempt <= max_attempts; attempt++)); do
	tip=$(git rev-parse --verify "$branch")
	git merge-base --is-ancestor "$target" "$tip" || fail "$target is not on $branch"
	others=$(git for-each-ref --format='%(refname)' --contains "$target" --exclude="$branch" \
		refs/heads refs/remotes refs/tags)
	if [[ -n $others ]]; then
		fail "$target is also in ${others//$'\n'/, }"
	fi
	commits=$({ echo "$target"; git rev-list --ancestry-path "$target..$tip"; } | git cat-file --batch)
	if grep -q '^gpgsig' <<< "$commits"; then
		fail "$target or a commit after it is signed, and git history would drop the signature"
	fi

	# Prints `update BRANCH NEW_TIP OLD_TIP`, or nothing if the branch moved meanwhile
	# shellcheck disable=SC2016 # the editor's shell expands $GIT_REWORD_MESSAGE
	update=$(GIT_DIR=$private GIT_REWORD_MESSAGE=$private/message GIT_EDITOR='cp "$GIT_REWORD_MESSAGE"' \
		git -c core.commentString=$comment history reword --dry-run --update-refs=branches "$target")
	if [[ ! $update =~ ^update\ "$branch"\ ([0-9a-f]+)\ "$tip"$ ]]; then
		if [[ $(git rev-parse --verify "$branch") != "$tip" ]]; then
			continue
		fi
		fail "git history reword printed: ${update:-nothing}"
	fi
	new_tip=${BASH_REMATCH[1]}

	# Moves the branch only if it still points to $tip
	if error=$(git update-ref -m "reword $target" --stdin <<< "$update" 2>&1); then
		# Prints `OLD -> NEW SUBJECT` for COMMIT and each commit after it, newest first
		count=$(($(git rev-list --count --ancestry-path "$target..$tip") + 1))
		paste -d ' ' <(git log --format=%h -n "$count" "$tip") \
			<(git log --format='%h %s' -n "$count" "$new_tip") | sed 's/ / -> /'
		exit 0
	fi
	if [[ $(git rev-parse --verify "$branch") == "$tip" ]]; then
		fail "git update-ref failed: $error"
	fi
done
fail "$branch kept moving, so gave up after $max_attempts attempts"
