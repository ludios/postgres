{
	"compilerOptions": {
		// Typecheck only. Node runs the .ts files directly (e.g. tests/simulate.ts),
		// and strips the types; vitest strips them too, when it runs the tests;
		// tsconfig.build.json emits JavaScript for publishing.
		"noEmit": true,
		// Node 22 is the oldest Node that this package supports.
		"target": "es2024",
		"lib": ["es2024"],
		"module": "nodenext",
		"types": ["node"],
		// So that Node's type stripping can run the code: imports name the .ts
		// file, type-only imports use `import type`, and the only TypeScript
		// syntax allowed is syntax that Node can erase.
		"allowImportingTsExtensions": true,
		"erasableSyntaxOnly": true,
		"verbatimModuleSyntax": true,
		// The parts of `strict` that the code satisfies so far.
		"useUnknownInCatchVariables": true,
		// Loose for now, so that adding type annotations to the files that were
		// converted from .js needs few code changes.
		"strict": false
	},
	"include": ["src", "tests", "vitest.config.ts"]
}
