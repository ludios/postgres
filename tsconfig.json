// Model-output: Claude Opus 5.5
{
	"compilerOptions": {
		// Typecheck only; Node runs the .ts files itself by stripping the types.
		"noEmit": true,
		// Node 22 is the oldest Node that this package supports.
		"target": "es2024",
		"lib": ["es2024"],
		"module": "nodenext",
		"types": ["node"],
		// Allow only the TypeScript syntax that Node's type stripping can run.
		"allowImportingTsExtensions": true,
		"erasableSyntaxOnly": true,
		"verbatimModuleSyntax": true,
		// Loose for now, so that converting the .js files to .ts changes little code.
		"strict": false,
		// Accept the .js files that are not converted yet, without checking them.
		"allowJs": true
	},
	"include": ["src", "tests"]
}
